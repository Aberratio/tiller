{
  "$id": "lane-confidence-dim",
  "type": "object",
  "properties": {
    "dimension": {
      "type": "string"
    },
    "reviewedSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "axis or dimension prefix: STD-1, SPEC-2"
          },
          "axis": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "high",
              "medium",
              "low"
            ]
          },
          "summary": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "path:line or path:from-to"
          },
          "source": {
            "type": "string",
            "enum": [
              "code",
              "harness",
              "verify-claim",
              "exec",
              "toolchain"
            ],
            "description": "who the finding is about: the code under review (default) or the run's own tooling; tooling findings go to blocked, never to a fix round"
          }
        },
        "required": [
          "id",
          "axis",
          "severity",
          "summary",
          "locations"
        ]
      }
    },
    "report": {
      "type": "string"
    },
    "acCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ac": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "covered",
              "partial",
              "uncovered"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "ac",
          "status",
          "evidence"
        ]
      }
    },
    "questions": {
      "type": "array",
      "description": "open questions the resolver may still settle",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "description": "evidence: path, quote, SHA, command output"
          }
        },
        "required": [
          "question",
          "options",
          "recommendation",
          "why"
        ]
      }
    },
    "awaiting": {
      "type": "array",
      "description": "items only a human or nobody can move; not questions",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "harness-blocked",
              "premise",
              "question",
              "manual-qa"
            ],
            "description": "harness-blocked: tool, permission or classifier denial"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "description": "evidence; for harness-blocked the literal denial text"
          },
          "reversalCost": {
            "type": "string"
          },
          "blocks": {
            "type": "string",
            "description": "what waits on it"
          }
        },
        "required": [
          "kind",
          "question",
          "why",
          "blocks"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "dimension",
    "reviewedSha",
    "findings",
    "report",
    "awaiting"
  ]
}
