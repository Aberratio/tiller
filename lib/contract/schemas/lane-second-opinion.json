{
  "$id": "lane-second-opinion",
  "type": "object",
  "properties": {
    "reviewedSha": {
      "type": "string"
    },
    "verdicts": {
      "type": "array",
      "description": "one per contested finding; a downgrade lowers severity and cites why, an uphold keeps it",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "axis": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "uphold",
              "downgrade"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "high",
              "medium",
              "low"
            ],
            "description": "severity after this opinion; a downgrade is below the finding's"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "description": "path:line, quote or command output the reason rests on"
          }
        },
        "required": [
          "id",
          "verdict",
          "severity",
          "reason",
          "evidence"
        ]
      }
    },
    "report": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "description": "open questions the resolver may still settle",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "description": "evidence: path, quote, SHA, command output"
          }
        },
        "required": [
          "question",
          "options",
          "recommendation",
          "why"
        ]
      }
    },
    "awaiting": {
      "type": "array",
      "description": "items only a human or nobody can move; not questions",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "harness-blocked",
              "premise",
              "question",
              "manual-qa"
            ],
            "description": "harness-blocked: tool, permission or classifier denial"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "description": "evidence; for harness-blocked the literal denial text"
          },
          "reversalCost": {
            "type": "string"
          },
          "blocks": {
            "type": "string",
            "description": "what waits on it"
          }
        },
        "required": [
          "kind",
          "question",
          "why",
          "blocks"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "reviewedSha",
    "verdicts",
    "awaiting"
  ]
}
