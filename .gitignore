.DS_Store

# Per-project profiles and per-person skills are local. Only their templates are tracked.
/profiles/*
!/profiles/_template/
/personal/*
!/personal/_templates/

# Brains are local vaults, each with its own git history. Only the template and example are tracked.
/brains/*
!/brains/_template/
!/brains/access.json.example

# The helm is a clone of a private repository; its template is lib/helm/template/.
/helm/

# Machine-local calibration output (harness.mjs calibrate)
/config/measured.json

# Release bundles, the repo root's own .claude/ (holds worktrees), installed packages
*.bundle
.claude/
node_modules/
