{
  "description": "Role vocabulary for tool names. A skill or role names `role:<role>.<op>` (or `role:<role>` for the whole server); a profile’s `## tools` picks the kind and server per role, and `## tracker` picks the tracker’s kind. Each op names its vendor tool and its access: `read`, or `write` with the outward channel (lib/contract/kinds.json outwardChannels) it reaches, `null` when the write stays inside the run. An unattended child is denied every write op whose channel is a hard stop, and every server whose `serverChannels` names one. A role whose kind is `none` grants nothing.",
  "roles": {
    "tracker": {
      "default": "jira",
      "kinds": {
        "jira": {
          "server": "atlassian",
          "ops": {
            "get": { "tool": "getJiraIssue", "access": "read" },
            "search": { "tool": "searchJiraIssuesUsingJql", "access": "read" },
            "transitions": { "tool": "getTransitionsForJiraIssue", "access": "read" },
            "transition": { "tool": "transitionJiraIssue", "access": "write", "channel": null },
            "edit": { "tool": "editJiraIssue", "access": "write", "channel": null },
            "create": { "tool": "createJiraIssue", "access": "write", "channel": null },
            "comment": { "tool": "addCommentToJiraIssue", "access": "write", "channel": null },
            "link": { "tool": "createIssueLink", "access": "write", "channel": null },
            "remote-links": { "tool": "getJiraIssueRemoteIssueLinks", "access": "read" },
            "lookup-user": { "tool": "lookupJiraAccountId", "access": "read" },
            "projects": { "tool": "getVisibleJiraProjects", "access": "read" },
            "issue-types": { "tool": "getJiraProjectIssueTypesMetadata", "access": "read" },
            "sites": { "tool": "getAccessibleAtlassianResources", "access": "read" },
            "me": { "tool": "atlassianUserInfo", "access": "read" }
          }
        }
      }
    },
    "chat": {
      "default": "slack",
      "kinds": {
        "slack": {
          "server": "slack",
          "ops": {
            "search": { "tool": "slack_search_public_and_private", "access": "read" },
            "search-public": { "tool": "slack_search_public", "access": "read" },
            "read-thread": { "tool": "slack_read_thread", "access": "read" },
            "read-channel": { "tool": "slack_read_channel", "access": "read" },
            "search-users": { "tool": "slack_search_users", "access": "read" },
            "search-channels": { "tool": "slack_search_channels", "access": "read" },
            "send": { "tool": "slack_send_message", "access": "write", "channel": "chat-send" },
            "schedule": { "tool": "slack_schedule_message", "access": "write", "channel": "chat-schedule" },
            "draft": { "tool": "slack_send_message_draft", "access": "write", "channel": null }
          }
        }
      }
    },
    "docs": {
      "default": "notion",
      "kinds": {
        "notion": {
          "server": "notion",
          "ops": {
            "search": { "tool": "notion-search", "access": "read" },
            "fetch": { "tool": "notion-fetch", "access": "read" }
          }
        },
        "confluence": {
          "server": "atlassian",
          "ops": {
            "search": { "tool": "searchConfluenceUsingCql", "access": "read" },
            "fetch": { "tool": "getConfluencePage", "access": "read" }
          }
        }
      }
    },
    "calendar": {
      "default": "google-calendar",
      "kinds": {
        "google-calendar": {
          "server": "google-calendar",
          "ops": {
            "list": { "tool": "list_events", "access": "read" },
            "search": { "tool": "search_events", "access": "read" },
            "get": { "tool": "get_event", "access": "read" },
            "create": { "tool": "create_event", "access": "write", "channel": "calendar-write" },
            "update": { "tool": "update_event", "access": "write", "channel": "calendar-write" },
            "delete": { "tool": "delete_event", "access": "write", "channel": "calendar-write" },
            "respond": { "tool": "respond_to_event", "access": "write", "channel": "calendar-write" }
          }
        }
      }
    },
    "email": {
      "default": "gmail",
      "kinds": {
        "gmail": {
          "server": "gmail",
          "ops": {},
          "serverChannels": ["email-send", "email-draft"]
        }
      }
    }
  }
}
