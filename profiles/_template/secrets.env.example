# This project's credentials: API tokens, staging access codes, test-user passwords.
# The only place their values live. Never copy one into profile.md or any tracked file.
# lib/new-profile.sh copies this to secrets.env and sets it to chmod 600; profiles/ is git-ignored.
# Source it in the shell that needs it: set -a; . profiles/<name>/secrets.env; set +a

# Issue tracker API token
TRACKER_TOKEN=
# Forge (e.g. GitHub) token, if the default gh login is not the right account
FORGE_TOKEN=
# Access code for a staging test user
STAGING_ACCESS_CODE=
